{
  "manifest_version": 3,
  "name": "115揮汗有禮自動登入助手",
  "version": "1.1.0",
  "description": "自動登入運動部115揮汗有禮活動登入資訊，並提供排程自動登入與任務狀態追蹤。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage",
    "alarms",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://500.gov.tw/registrant/*"],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}